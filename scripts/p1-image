#!/usr/bin/env python3
"""Convert an already-built W01/W02 ELF; never builds or launches QEMU."""
import argparse
import json
from pathlib import Path
import struct
import subprocess
import tempfile

from p1_runner import DEFAULT_IMAGE, ROOT, image_identity, write_json

parser = argparse.ArgumentParser()
parser.add_argument("--elf", type=Path, default=ROOT / "target/aarch64-unknown-none-softfloat/debug/hypervisor")
parser.add_argument("--output", type=Path, default=DEFAULT_IMAGE)
options = parser.parse_args()
try:
    options.output.parent.mkdir(parents=True, exist_ok=True)
    if options.output.exists() or options.output.with_suffix(".json").exists():
        raise ValueError("image or provenance path already exists; select a fresh --output")
    source = image_identity(options.elf)
    version = subprocess.run(["llvm-objcopy", "--version"], check=True, capture_output=True, text=True).stdout
    with tempfile.TemporaryDirectory() as scratch:
        raw = Path(scratch) / "image.raw"
        subprocess.run(["llvm-objcopy", "-O", "binary", str(options.elf), str(raw)], check=True)
        body = raw.read_bytes()
    header = struct.pack("<IIQQQQQQII", 0x14000010, 0, 0x80000, 64 + len(body), 0, 0, 0, 0, 0x644D5241, 0)
    with options.output.open("xb") as image:
        image.write(header)
        image.write(body)
    provenance = {"source_elf": source, "image": image_identity(options.output),
                  "conversion": "W01 64-byte ARM64 Image header plus llvm-objcopy binary body",
                  "converter": version.strip()}
    write_json(options.output.with_suffix(".json"), provenance)
    print(json.dumps(provenance))
except (OSError, ValueError, subprocess.SubprocessError) as error:
    parser.exit(1, str(error) + "\n")
